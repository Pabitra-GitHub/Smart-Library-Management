# ==============================================================================
# Git Ignore Configuration for AI Smart Library
# ==============================================================================

# Node dependencies (Never commit node_modules)
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files & swap files
*.tmp
*.tmp.*
data/*.tmp.*
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
